Executing (default): INSERT INTO "comments" ("id","user_id","original_comment","context","tone","platform","ai_output","status","created_at","updated_at") VALUES (DEFAULT,1,'This video changed my life! Thank you so much!','Motivational content video','Grateful and warm','YouTube','Thank you so much for sharing this! Comments like yours are exactly why I create content. I''m so happy this resonated with you. Keep pushing forward - you''ve got this! Would love to hear about your journey in my next video''s comments!','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'Can you do a tutorial on editing?','Behind the scenes video','Helpful and encouraging','YouTube','Great suggestion! I''ve actually been planning an editing tutorial series. I''ll add this to my content calendar! In the meantime, I use DaVinci Resolve - it''s free and amazing for beginners. Stay tuned!','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'This is wrong, you don''t know what you''re talking about','Educational/review video','Professional and respectful','YouTube','I appreciate you sharing your perspective! I''d love to learn more about your experience with this. Could you share what specifically you''d approach differently? Always looking to improve and provide accurate information to the community.','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'What camera do you use?','Any video','Informative','YouTube','Great question! I''m currently using the Sony A7IV with a 24-70mm lens. For my TikToks, I just use my iPhone 15 Pro. I have a full gear list in my video description! Let me know if you have any other questions.','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'First!','Any video','Playful and engaging','YouTube','And a great first commenter you are! Thanks for being here early and supporting the channel. What did you think of the video? Would love to hear your thoughts!','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'I''ve been following you since you had 100 subscribers!','Milestone video','Appreciative','YouTube','Wow, you''re a real OG! I can''t thank you enough for being on this journey with me from the beginning. You''ve literally watched me grow, and that means everything. Here''s to many more milestones together!','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'This video was too long','Tutorial video','Understanding but confident','YouTube','Thanks for the feedback! I know longer videos aren''t for everyone. I''ve added timestamps in the description so you can jump to the sections most relevant to you. I also have shorter versions on my TikTok if that''s more your style!','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'Can we collab?','Any video','Professional but friendly','Instagram','Hey! Always open to collaborations with creators who share similar values. Send me a DM with your channel/content and some ideas you have in mind. Let''s see if we can create something awesome together!','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'When''s your next upload?','Any video','Excited','YouTube','So glad you''re looking forward to more content! I upload every Tuesday and Friday. Hit the notification bell so you don''t miss the next one - I''ve got something really special coming up!','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'This is literally me every morning lol','Relatable content','Fun and relatable','TikTok','Haha, we''re all the same! The morning struggle is REAL. At least we''re in this together! Drop a coffee emoji if you can''t function without caffeine like me.','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'You should try [product/technique]','Tutorial/review','Open and interested','YouTube','Oh interesting suggestion! I''ve heard about that but haven''t tried it yet. I''ll definitely look into it for a future video. Have you tried it personally? Would love to hear your experience!','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'This was so helpful, saved for later!','Educational content','Encouraging','Instagram','Yes! Save it and come back whenever you need a refresher. I''m so glad this was helpful! Feel free to DM me if you have any questions when you try implementing this.','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'You copied [other creator]','Any video','Calm and professional','TikTok','I understand why you might think that! Actually, this is a pretty common topic/trend that many creators cover. I try to bring my own perspective and style to everything I create. I have respect for all creators in this space!','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'The audio quality could be better','Any video','Receptive to feedback','YouTube','You''re right, and I appreciate the honest feedback! I''ve actually just upgraded my audio setup, so future videos should sound much better. Thanks for helping me improve!','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00'),(DEFAULT,1,'Best content on the platform!','Any video','Humble and grateful','YouTube','Wow, that means so much! I''m just trying to create value for this amazing community. Thank you for being here and for the kind words. You all motivate me to keep improving!','draft','2026-01-26 12:07:41.164 +00:00','2026-01-26 12:07:41.164 +00:00') RETURNING "id","user_id","original_comment","context","tone","platform","ai_output","status","scheduled_at","created_at","updated_at";
